[Unit]
Description=snapfree-os first boot fixup (timezone, apt mirror, swap)
Documentation=man:systemd-firstboot(1)
After=local-fs.target network-online.target systemd-timesyncd.service
Wants=network-online.target systemd-timesyncd.service
# 首启跑一次即可；失败允许后续启动重试
ConditionPathExists=!/var/lib/sf-firstboot.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sf-firstboot
TimeoutStartSec=300
Nice=10

[Install]
WantedBy=multi-user.target
