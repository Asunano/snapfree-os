# ============================================================
# 核心包清单（Debian 服务器向，必装）
#   运维常用工具在 packages-ops.list（WITH_OPS=0 可去掉）
#   黑名单在 packages.remove（误入会被 purge）
#
# 这里刻意不含：
#   - 任何业务软件（nginx / apache2 / php / mariadb / postgresql）
#   - nodejs / npm / docker / linux-firmware
# ============================================================

# ---- init / 基础 ----
systemd
systemd-sysv
udev
dbus
kmod
procps
psmisc
util-linux
e2fsprogs
dosfstools

# ---- 网络 / 下载（curl、wget 必须预装）----
iptables
iproute2
iputils-ping
curl
wget
ca-certificates
gnupg

# ---- 账户 / 区域 / 日志 ----
sudo
locales
tzdata
less
logrotate

# ---- 远程 / 初始化 ----
openssh-server
cloud-init
cloud-guest-utils
# 时间同步与 DNS：Debian 的 timesyncd / resolved 都是独立包，不装就没有对应服务
systemd-timesyncd
systemd-resolved
debian-archive-keyring

# ---- 启动链 ----
grub-common
grub2-common
grub-efi-amd64-bin
grub-pc
grub-pc-bin
initramfs-tools
linux-image-amd64
